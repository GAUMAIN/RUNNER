@using System
@using Sandbox
@using Sandbox.UI
@using System.Linq
@using Runner.Player
@using Runner.Events
@using Runner.Systems
@inherits PanelComponent

<root>

	<div class="speed-vignette" style="opacity: @(VignetteOpacity.ToString( "0.000", System.Globalization.CultureInfo.InvariantCulture ));"></div>

	<div class="level-up-flash @(IsFlashing ? "active" : "")"></div>

	@if ( _stats.IsValid() )
	{
		<div class="hud-top">
			<div class="level-card @(IsFlashing ? "pulse" : "")">
				<div class="label">LEVEL</div>
				<div class="value">@_stats.Level</div>
			</div>

			<div class="xp-block @(IsFlashing ? "pulse" : "")">
				<div class="xp-text">
					<span class="xp-current">@FormatNumber( _xpInLevel )</span>
					<span class="xp-sep">/</span>
					<span class="xp-needed">@FormatNumber( _xpNeeded )</span>
					<span class="xp-label">XP</span>
				</div>
				<div class="xp-bar">
					<div class="xp-bar-fill" style="width: @(XpPercent.ToString( "0.00", System.Globalization.CultureInfo.InvariantCulture ))%;"></div>
				</div>
				<div class="mult">×@_stats.SpeedMultiplier.ToString( "0.00", System.Globalization.CultureInfo.InvariantCulture ) SPEED</div>
			</div>

			<div class="coins-block">
				<div class="coin-icon">●</div>
				<div class="coin-text">
					<div class="coin-value">@FormatNumber( _stats.Coins )</div>
					<div class="coin-label">COINS</div>
				</div>
			</div>
		</div>

		<div class="speedometer">
			<div class="speed-value">@((int)_speed)</div>
			<div class="speed-unit">u/s</div>
		</div>
	}
	else
	{
		<div class="searching">searching for local player…</div>
	}

</root>

@code
{
	[Property] public SoundEvent LevelUpSound { get; set; }
	[Property] public SoundEvent CashOutSound { get; set; }
	[Property] public SoundEvent RebirthSound { get; set; }
	[Property] public SoundEvent ShopBuySound { get; set; }

	private PlayerStats _stats = null;
	private PlayerPawn _pawn = null;
	private float _speed;
	private long _xpInLevel;
	private long _xpNeeded = 100;

	private TimeSince _timeSinceLevelUp = 999f;
	private const float FlashDuration = 0.6f;
	public bool IsFlashing => _timeSinceLevelUp < FlashDuration;

	protected override void OnEnabled()
	{
		base.OnEnabled();
		EventBus.Subscribe<PlayerLeveledUp>( OnLevelUp );
		EventBus.Subscribe<PlayerCurrencyChanged>( OnCurrencyChanged );
		EventBus.Subscribe<PlayerRebirthed>( OnRebirthed );
	}

	protected override void OnDisabled()
	{
		base.OnDisabled();
		EventBus.Unsubscribe<PlayerLeveledUp>( OnLevelUp );
		EventBus.Unsubscribe<PlayerCurrencyChanged>( OnCurrencyChanged );
		EventBus.Unsubscribe<PlayerRebirthed>( OnRebirthed );
	}

	// Fallback paths — used when the Inspector slot is empty. Override by assigning in HudPanel inspector.
	private const string FallbackLevelUp = "sounds/kenney/ui/ui.favourite.sound";
	private const string FallbackCashOut = "sounds/kenney/ui/ui.upvote.sound";
	private const string FallbackRebirth = "sounds/kenney/ui/ui.popup.message.open.sound";
	private const string FallbackShopBuy = "sounds/kenney/ui/ui.button.press.sound";

	private static void PlaySafe( SoundEvent assigned, string fallback )
	{
		if ( assigned is not null )
		{
			Sound.Play( assigned );
			return;
		}
		Sound.Play( fallback );
	}

	private void OnLevelUp( PlayerLeveledUp evt )
	{
		_timeSinceLevelUp = 0f;
		PlaySafe( LevelUpSound, FallbackLevelUp );
	}

	private void OnCurrencyChanged( PlayerCurrencyChanged evt )
	{
		if ( evt.Currency != "coins" )
			return;

		if ( evt.Delta > 0 )
			PlaySafe( CashOutSound, FallbackCashOut );
		else if ( evt.Delta < 0 )
			PlaySafe( ShopBuySound, FallbackShopBuy );
	}

	private void OnRebirthed( PlayerRebirthed evt )
	{
		PlaySafe( RebirthSound, FallbackRebirth );
	}

	public float XpPercent => _xpNeeded <= 0 ? 0f : ((float)_xpInLevel / _xpNeeded) * 100f;

	// Vignette ramps in between VignetteStart and VignetteFull speeds, capped at MaxOpacity.
	private const float VignetteStart = 400f;
	private const float VignetteFull = 2000f;
	private const float MaxOpacity = 0.75f;

	public float VignetteOpacity
	{
		get
		{
			if ( _speed <= VignetteStart ) return 0f;
			float t = (_speed - VignetteStart) / (VignetteFull - VignetteStart);
			if ( t > 1f ) t = 1f;
			return t * MaxOpacity;
		}
	}

	protected override void OnUpdate()
	{
		if ( !_stats.IsValid() || !_pawn.IsValid() )
			ResolveLocalPlayer();

		if ( _stats.IsValid() )
		{
			var (cur, need) = _stats.GetLevelProgress();
			_xpInLevel = cur;
			_xpNeeded = need;
		}

		if ( _pawn.IsValid() )
		{
			var cc = _pawn.GameObject.Components.Get<CharacterController>();
			if ( cc.IsValid() )
				_speed = cc.Velocity.WithZ( 0 ).Length;
		}
	}

	private void ResolveLocalPlayer()
	{
		_stats = Scene.GetAllComponents<PlayerStats>().FirstOrDefault( s => !s.IsProxy );
		_pawn = Scene.GetAllComponents<PlayerPawn>().FirstOrDefault( p => !p.IsProxy );
	}

	private static string FormatNumber( long n )
	{
		if ( n >= 1_000_000 ) return (n / 1_000_000.0).ToString( "0.0", System.Globalization.CultureInfo.InvariantCulture ) + "M";
		if ( n >= 10_000 )    return (n / 1_000.0).ToString( "0.0", System.Globalization.CultureInfo.InvariantCulture ) + "K";
		return n.ToString();
	}

	// Rebuild the panel only when these change.
	protected override int BuildHash()
	{
		int level = _stats.IsValid() ? _stats.Level : 0;
		long coins = _stats.IsValid() ? _stats.Coins : 0;
		return HashCode.Combine( level, _xpInLevel, _xpNeeded, (int)_speed, _stats.IsValid(), IsFlashing, coins );
	}
}
