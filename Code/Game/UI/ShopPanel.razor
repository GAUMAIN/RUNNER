@using System
@using Sandbox
@using Sandbox.UI
@using System.Linq
@using Runner.Economy
@using Runner.Player
@using Runner.World
@inherits PanelComponent

<root>
	@if ( _visible && _stats.IsValid() )
	{
		<div class="shop">
			<div class="title">UPGRADES SHOP</div>

			<div class="rows">
				@foreach ( var upg in ShopUpgrades.All )
				{
					int lvl = _stats.GetUpgradeLevel( upg.Type );
					long cost = ShopUpgrades.CostAtLevel( upg, lvl );
					bool affordable = _stats.Coins >= cost;
					var capturedType = upg.Type;

					<div class="row @(affordable ? "affordable" : "broke")" @onclick=@(() => OnRowClicked(capturedType))>
						<div class="hotkey">@upg.Hotkey</div>
						<div class="info">
							<div class="name">@upg.Name</div>
							<div class="lvl">Lvl @lvl</div>
						</div>
						<div class="cost">
							<span class="cost-coin">●</span>
							<span class="cost-value">@cost</span>
						</div>
					</div>
				}
			</div>

			<div class="hint">Press 1 · 2 · 3 to buy   ·   walk off the pad to close</div>
		</div>
	}
</root>

@code
{
	private bool _visible;
	private bool _wasVisible;
	private PlayerStats _stats;

	protected override void OnUpdate()
	{
		var pad = Scene.GetAllComponents<ShopPad>().FirstOrDefault();
		if ( pad.IsValid() )
		{
			_visible = pad.IsPlayerNear;
			_stats = pad.NearbyStats;
		}
		else
		{
			_visible = false;
			_stats = null;
		}

		// Toggle cursor mode with the modal — visible while shopping, locked otherwise.
		if ( _visible != _wasVisible )
		{
			Mouse.Visible = _visible;
			_wasVisible = _visible;
		}
	}

	private void OnRowClicked( UpgradeType type )
	{
		if ( !_stats.IsValid() )
			return;
		_stats.TryBuyUpgrade( type );
	}

	protected override int BuildHash()
	{
		long coins = _stats.IsValid() ? _stats.Coins : 0;
		int sp = _stats.IsValid() ? _stats.Upgrade_Speed : 0;
		int xp = _stats.IsValid() ? _stats.Upgrade_Xp : 0;
		int cn = _stats.IsValid() ? _stats.Upgrade_Coin : 0;
		return HashCode.Combine( _visible, coins, sp, xp, cn );
	}
}
