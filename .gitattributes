# Auto detect text files and normalize line endings
* text=auto eol=lf

# C# / Code
*.cs       text diff=csharp eol=lf
*.csproj   text eol=lf
*.sln      text eol=crlf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.xml      text eol=lf

# S&box source files
*.sbproj   text eol=lf
*.shader   text eol=lf
*.vfx      text eol=lf
*.vmat     text eol=lf
*.vsmart   text eol=lf
*.scene    text eol=lf
*.prefab   text eol=lf
*.object   text eol=lf

# ────────────────────────────────────────────────────────────────────────────
# Treat binary asset formats as binary (no merge, no diff)
# ────────────────────────────────────────────────────────────────────────────
*.vmdl     binary
*.vmesh    binary
*.vanim    binary
*.vagrp    binary
*.vmap     binary
*.vsnd     binary
*.vtex     binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.tga      binary
*.psd      binary
*.fbx      binary
*.glb      binary
*.gltf     binary
*.wav      binary
*.mp3      binary
*.ogg      binary

# ────────────────────────────────────────────────────────────────────────────
